{
  "name": "@marianmeres/uid",
  "version": "1.2.0",
  "description": "One uid() function, many id strategies: UUID v4/v7, ULID, nanoid-style ids, base56/58/62 and other alphabets, in-memory counters, reversible integer codecs and opt-in human-readable ids. Crypto-backed, zero-dependency core.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./rhr": {
      "types": "./dist/rhr.d.ts",
      "import": "./dist/rhr.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/uid.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/uid/issues"
  },
  "homepage": "https://github.com/marianmeres/uid#readme",
  "keywords": [
    "uid",
    "uuid",
    "uuidv7",
    "ulid",
    "nanoid",
    "unique-id",
    "short-id",
    "base56",
    "base58",
    "base62",
    "hashids",
    "human-readable"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "deno test --no-check --no-lock --config jsr.json tests/",
    "jsr:check": "deno publish --dry-run --allow-dirty --no-check --set-version \"$npm_package_version\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "example:build": "bundle --root example/src --entry app.ts --outdir example/dist",
    "example:watch": "bundle --root example/src --entry app.ts --outdir example/dist --watch --watch-dir src",
    "example:serve": "node example/server.ts",
    "example:themes": "node example/themes/_generate.ts",
    "release": "npx --yes @marianmeres/release@^2.2.0 --before-commit \"pnpm run example:build\"",
    "publish:jsr": "pnpm run test:deno && deno publish --no-check --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "peerDependencies": {
    "@marianmeres/random-human-readable": "^1.10.2"
  },
  "peerDependenciesMeta": {
    "@marianmeres/random-human-readable": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@marianmeres/bundle": "^1.0.0",
    "@marianmeres/demino": "^2.1.0",
    "@marianmeres/design-tokens": "^1.13.0",
    "@marianmeres/random-human-readable": "^1.10.2",
    "@marianmeres/vanilla": "^1.8.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
