{
  "name": "@marianmeres/uid",
  "version": "1.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./rhr": "./src/rhr.ts"
  },
  "tasks": {
    "test": "deno test",
    "test:watch": "deno test --watch",
    "example:themes": "deno run -A example/themes/_generate.ts",
    "example:build": "deno run -A jsr:@marianmeres/deno-build --root example/src --entry app.ts --outdir example/dist",
    "example:watch": "deno run -A jsr:@marianmeres/deno-build --root example/src --entry app.ts --outdir example/dist --watch --watch-dir src",
    "example:serve": "deno run -A jsr:@std/http/file-server example --port 8000",
    "npm:build": "deno run -A scripts/build-npm.ts",
    "npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
    "release": "deno run -A jsr:@marianmeres/release",
    "publish": "deno publish && deno task npm:publish",
    "rp": "deno task release -y && deno task publish",
    "rpm": "deno task release minor -y && deno task publish"
  },
  "imports": {
    "@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
    "@marianmeres/random-human-readable": "jsr:@marianmeres/random-human-readable@^1.10.2",
    "@marianmeres/vanilla": "jsr:@marianmeres/vanilla@^1.8.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "publish": {
    "exclude": [
      "tests/",
      "scripts/",
      "example/",
      "index.html",
      "tmp/",
      ".editorconfig",
      ".env.example",
      "deno.lock"
    ]
  },
  "fmt": {
    "exclude": [
      "example/dist"
    ],
    "useTabs": true,
    "lineWidth": 90,
    "indentWidth": 4,
    "proseWrap": "preserve"
  }
}
